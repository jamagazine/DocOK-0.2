# ============================================
# DocOK .gitignore
# Версия: 0.2.9.1
# Дата: 13.04.2026
# ============================================

# --- Node.js зависимости ---
node_modules/
jspm_packages/
web_modules/
.npm
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.yarn-integrity

# --- Python зависимости ---
venv/
.venv/
env/
ENV/
python_portable/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.antigravity/

# --- Сборка и кэш ---
dist/
dist-ssr/
out/
build/
.cache/
.parcel-cache/
.temp/
.tsbuildinfo
.eslintcache
.stylelintcache
*.local
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# --- Данные проектов (ВАЖНО!) ---
data/projects/*
!data/projects/.gitkeep
!data/projects/live-main/
server/storage/
server/projects/
!server/projects/.gitkeep
server/temp_import/
server/*.zip

# --- Документы пользователей ---
*.pdf
*.xlsx
*.xls
*.csv
*.docx
*.doc
# Исключения для тестовых файлов
!ДЛЯ\ ТЕСТОВ/*.pdf
!ДЛЯ\ ТЕСТОВ/*.xlsx
!ДЛЯ\ ТЕСТОВ/*.xls

# --- Временные и промежуточные файлы ---
temp_output/
tmp/
extracted_text.txt
*_raw_ocr.json
*_invoice.md
*_invoice_final.md
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
_legacy/

# --- Логи ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*
.node_repl_history

# --- Конфиденциальные данные ---
.env
.env.local
.env.*.local
.env.production
!.env.example
config.json
server/config.json
**/config.local.json
*.key
*.pem
.tern-port

# --- IDE и редакторы ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
.agent/
.vscode-test

# --- Модели и тяжелые файлы ---
models/
*.gguf
*.bin
*.safetensors

# --- Системные файлы ---
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# --- Process files ---
pids
*.pid
*.seed
*.pid.lock
lib-cov
coverage/
.nyc_output
.grunt
bower_components
.lock-wscript

# --- Прочее ---
*.tgz
.dynamodb/
.firebase/
.serverless/
.fusebox/
.docusaurus/

# ============================================
# Исключения (должны быть в Git)
# ============================================
!package.json
!package-lock.json
!pnpm-lock.yaml
!requirements.txt
!.gitignore
!.env.example
!README.md
!БАЗА\ ЗНАНИЙ/**
!ОТЧЁТЫ/**
